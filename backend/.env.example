# Copy this file to ".env" and fill in real values. Never commit the real ".env" file.

# Server
PORT=5000
NODE_ENV=development

# MongoDB (Atlas connection string or local)
MONGO_URI=mongodb://127.0.0.1:27017/gympass

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS + cookie settings)
CLIENT_URL=http://localhost:5173

# Cloudinary (added in a later phase)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Razorpay (added in a later phase)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
